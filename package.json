{
  "name": "margdisha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:single": "vite build --mode single",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:seed-sql": "esbuild scripts/gen-seed-sql.ts --bundle --platform=node --format=esm --outfile=scripts/.gen-seed.mjs && node scripts/.gen-seed.mjs",
    "notices": "esbuild scripts/collect-notices.ts --bundle --platform=node --format=esm --outfile=scripts/.collect-notices.mjs && node scripts/.collect-notices.mjs",
    "fn:build": "esbuild src/notices/edge-entry.ts --bundle --format=esm --platform=neutral --target=es2022 --banner:js='// GENERATED by npm run fn:build from src/notices. Do not edit by hand.' --outfile=supabase/functions/collect-notices/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-singlefile": "2.2.0",
    "vitest": "3.2.4"
  }
}
